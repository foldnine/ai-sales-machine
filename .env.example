# ai-sales-machine environment template
# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env && chmod 600 .env
#
# REQUIRED  = the stack will not start or will not work correctly without it
# OPTIONAL  = only needed once the corresponding phase is implemented

# ---------------------------------------------------------------------------
# Core / general                                              REQUIRED
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=aisales
# Schedules, the sending window and the night drafting window all use this.
# Set it to where you and your recipients are, e.g. Europe/Berlin.
GENERIC_TIMEZONE=UTC
TZ=UTC
# How every crawler in the stack identifies itself to the sites it reads (WF-01,
# WF-02, WF-03, the OSM and Minimax refresh). Put your own site or a contact URL
# in it, so a site owner who sees the traffic knows who to ask. Keep the quotes.
BOT_USER_AGENT="AiSalesMachineBot/1.0 (+https://example.com/bot)"

# ---------------------------------------------------------------------------
# PostgreSQL                                                  REQUIRED
# ---------------------------------------------------------------------------
POSTGRES_USER=aisales
POSTGRES_PASSWORD=
POSTGRES_DB=aisales
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side bind address for the published port. Keep on loopback.
POSTGRES_BIND_ADDR=127.0.0.1
POSTGRES_BIND_PORT=5432

# ---------------------------------------------------------------------------
# n8n                                                         REQUIRED
# ---------------------------------------------------------------------------
# Public hostname Caddy will serve. Placeholder until a real domain exists.
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_PORT=5678
# Host-side bind for direct access (bypassing Caddy). Keep on loopback.
N8N_BIND_ADDR=127.0.0.1
N8N_BIND_PORT=5678
# Generate once and never rotate without re-entering all n8n credentials:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# No N8N_BASIC_AUTH_*: n8n removed basic auth in 1.0 and ignores it. Keep the
# editor off the public internet (CADDY_BIND_ADDR below).
#
# The n8n owner account. `make n8n-owner` (and ./install.sh) creates it on a
# fresh instance, so nobody who reaches the editor first can claim it. The
# password is generated by `make init` when empty; n8n requires 8-64
# characters with at least one number and one uppercase letter.
N8N_OWNER_EMAIL=
N8N_OWNER_NAME="AI Sales Operator"
N8N_OWNER_PASSWORD=
# Full external URL used for webhooks. Must match what Caddy serves.
WEBHOOK_URL=https://n8n.example.com/
N8N_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Caddy                                                       REQUIRED
# ---------------------------------------------------------------------------
CADDY_DOMAIN=n8n.example.com
# Used by Let's Encrypt for expiry notices.
CADDY_EMAIL=
# Host address Caddy binds to. Loopback by default: nothing here needs inbound
# traffic. For remote access use `tailscale serve` (docs/setup.md), not a
# wider bind. 0.0.0.0 publishes the n8n editor to the internet.
CADDY_BIND_ADDR=127.0.0.1
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Ollama (local LLM)                                          REQUIRED
# ---------------------------------------------------------------------------
# Ollama runs natively on the host, not in a container: a container on macOS has
# no Metal access and would run on the CPU. docker-compose.yml maps the hostname
# "ollama" to the host gateway, so this URL works unchanged from inside n8n.
# See docs/ollama.md.
OLLAMA_BASE_URL=http://ollama:11434
# Default local model for cheap/bulk work (classification, extraction).
OLLAMA_MODEL=llama3.1:8b
# Research runs on a larger context window than triage: the research schema
# plus a page of fetched material does not fit in the default 4096 tokens.
OLLAMA_RESEARCH_MODEL=qwen9-64k:latest
# Scoring reads the rubric, the research output and every signal at once, so it
# needs the same large window as research.
OLLAMA_SCORING_MODEL=qwen9-64k:latest
OLLAMA_OUTREACH_MODEL=qwen9-64k:latest
# WF-08 classifies every reply. It is the highest-volume and lowest-stakes call
# in the system, so it runs on the small model - and escalates to a larger one
# rather than to an API when its own confidence is below 0.7.
#
# prompts/classifier.md specifies escalating to the external LLM. There is no
# LLM_API_KEY, and a bigger local model is the same idea at no cost: ask
# something slower and better when the fast answer is not trustworthy.
# How often WF-08 reconnects to IMAP. IDLE fires when mail arrives; it does
# not fire for a flag change or for anything that landed while the socket
# was down, and a reconnect re-runs the UNSEEN search. This is therefore
# the worst-case delay before a reply is seen.
INBOX_RECONNECT_MINUTES=5
OLLAMA_CLASSIFIER_MODEL=llama3.1:8b
OLLAMA_CLASSIFIER_ESCALATION_MODEL=qwen3.6:27b
CLASSIFIER_MODEL_TIMEOUT_MS=120000
CLASSIFIER_ESCALATION_TIMEOUT_MS=300000
# WF-08 drafts a suggested answer to a POSITIVE, QUESTION or PRICE reply and
# sends it to Telegram (prompts/reply-draft.md). Nothing is sent to the customer.
OLLAMA_REPLY_MODEL=qwen3.6:27b
REPLY_MODEL_TIMEOUT_MS=900000
# Enrichment transcribes a team page rather than reasoning about it, so the
# small model is enough and is five times faster.
OLLAMA_ENRICHMENT_MODEL=llama3.1:8b
OLLAMA_KEEP_ALIVE=10m

# ---------------------------------------------------------------------------
# Discovery (WF-01)                                           OPTIONAL
# ---------------------------------------------------------------------------
# WF-01 reads free public directories - the Y Combinator company list, the
# monthly Hacker News "Who is hiring?" thread, and optionally OpenStreetMap and
# the Minimax directory below. None needs an API key.
#
# This is the throttle on the whole pipeline. Set it to what research can
# actually read in a day: with a local model one company costs roughly 7 GPU
# minutes (research ~4.6 in a batch of five, scoring ~2.3 on a 24 GB Apple
# silicon machine), so about 170 a day fit around the night drafting window.
# Raising it past what research reads only produces a longer backlog. Start
# lower (20-40) on smaller hardware.
DISCOVERY_DAILY_LIMIT=120
# The size band. Below the minimum there is no production infrastructure worth
# auditing; above the maximum there is a platform team, and the person being
# sold to is already employed. YC reports whole-company headcount, so the
# engineering team inside these numbers is considerably smaller.
DISCOVERY_MIN_TEAM_SIZE=10
DISCOVERY_MAX_TEAM_SIZE=120
# How far back in the YC batches to look. A company still at 15 people ten
# years after its batch is not growing, and growth is what creates the
# operational load this system sells against.
DISCOVERY_MAX_BATCH_AGE_YEARS=8
# OpenStreetMap: businesses in these countries (ISO codes, e.g. RS,HR,BA) that
# list a website on the map, the source for the automation line
# (docs/lead-discovery.md). Empty switches it off. infra/scripts/osm-extract.sh
# maps a country to its Geofabrik download; add yours there if it is missing. How many of DISCOVERY_DAILY_LIMIT each ICP segment gets is
# icp_segments.discovery_share (0025_segment_allocation.sql); a domain on more than MAX_LOCATIONS map points is a chain.
DISCOVERY_OSM_COUNTRIES=
DISCOVERY_OSM_MAX_LOCATIONS=3
# `make osm-refresh` (weekly from cron) fills the snapshots from Geofabrik's
# downloads. WF-12 is the fallback: it asks Overpass for a country's map data
# only once it is REFRESH_DAYS old, at most PER_DAY countries a day.
DISCOVERY_OSM_REFRESH_DAYS=7
DISCOVERY_OSM_REFRESH_PER_DAY=3
# Minimax's public directory of accounting offices, the source for the
# accounting_offices segment (0029_minimax_directory.sql). Only SI, RS and HR
# are mapped. Empty switches it off; `make deploy` refreshes it when set.
DISCOVERY_MINIMAX_COUNTRIES=

# ---------------------------------------------------------------------------
# Research pass (WF-02)                                       OPTIONAL
# ---------------------------------------------------------------------------
# Companies researched per pass.
RESEARCH_BATCH_SIZE=5
# Output budget for one research response, thinking included. Raised from 8000
# when the schema gained absence_checks and the people counts, and to 20000 when
# runs came back empty with the budget spent on reasoning: a response cut off at
# the limit is unparseable JSON, not a partial answer, and the run is discarded.
RESEARCH_MAX_TOKENS=20000
# Wall clock on the research HTTP request, so it must cover the QUEUE: Ollama
# serves one request at a time, so with RESEARCH_BATCH_SIZE=5 the last company
# waits out the other four. Budget batch x per-company time x 1.5. The 900000
# default fits one company, not a batch.
RESEARCH_MODEL_TIMEOUT_MS=2700000
TRIAGE_MODEL_TIMEOUT_MS=180000
SCORING_MODEL_TIMEOUT_MS=900000
OUTREACH_MODEL_TIMEOUT_MS=900000
ENRICHMENT_MODEL_TIMEOUT_MS=600000
# How many queued companies are looked at to fill that batch. It is larger than
# the batch because companies whose domain is still cooling down are skipped
# over rather than claimed.
RESEARCH_CANDIDATE_POOL=25
# Minimum gap between two fetch passes against the same domain, across runs.
# Held in domain_fetch_log, so it survives a restart.
RESEARCH_DOMAIN_COOLDOWN_MINUTES=60
# Spacing inside one pass: pages per burst and the pause between bursts.
RESEARCH_FETCH_BATCH_SIZE=1
RESEARCH_FETCH_BATCH_INTERVAL_MS=1000

# External ATS job boards (WF-02). Six paths on a company's own domain miss the
# hiring signal for most companies: the adverts live on Greenhouse, Ashby,
# Lever, Workable, Recruitee, Teamtailor or Personio, whose job-board JSON is
# public and needs no key. RESEARCH_ATS_MAX_CANDIDATES caps how many boards are
# probed per company; a board linked from the company's own careers page is
# used on its own and no guesses are made.
RESEARCH_ATS_MAX_CANDIDATES=8
RESEARCH_ATS_BATCH_INTERVAL_MS=400
RESEARCH_ATS_MAX_CHARS=14000
RESEARCH_MATERIAL_MAX_CHARS=32000

# ---------------------------------------------------------------------------
# Contact enrichment (WF-03)                                  OPTIONAL
# ---------------------------------------------------------------------------
# Companies enriched per pass, and how many are looked at to fill that batch.
# Enrichment also runs for NURTURE companies a contact would lift over their
# segment's bar (0024_icp_segments.sql).
ENRICH_BATCH_SIZE=6
ENRICH_CANDIDATE_POOL=15
# A company whose pages name nobody is not looked at again for this long.
# docs/workflows.md: "No contact found is a normal outcome."
ENRICH_RETRY_DAYS=30

# ---------------------------------------------------------------------------
# Re-scoring sweep (WF-04)                                    OPTIONAL
# ---------------------------------------------------------------------------
# A scored company is re-scored after this many days. It is also re-scored as
# soon as a contact is added to it, whatever its age.
RESCORE_AFTER_DAYS=7
RESCORE_BATCH_SIZE=50

# ---------------------------------------------------------------------------
# External LLM (higher-quality reasoning)                     REQUIRED
# ---------------------------------------------------------------------------
# Used for research, scoring rationale, outreach drafting and conversation.
LLM_PROVIDER=anthropic
LLM_API_BASE=https://api.anthropic.com
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Telegram control plane                                      OPTIONAL (Phase 3)
# ---------------------------------------------------------------------------
# The bot token does NOT go here. WF-10 sends through the n8n Telegram node,
# which reads it from an n8n credential, so it never reaches a workflow file or
# an execution URL. See docs/telegram.md for the three setup steps.
TELEGRAM_BOT_TOKEN=
# Only this chat id is notified, and only it may issue commands.
TELEGRAM_CHAT_ID=
# WF-10 claims nothing at all unless this is exactly "true". Until then every
# notification simply accumulates in the notifications table.
TELEGRAM_ENABLED=false

# ---------------------------------------------------------------------------
# Notification outbox (WF-10)                                 OPTIONAL
# ---------------------------------------------------------------------------
# Every value below has the same default in the workflow, so an empty .env
# behaves exactly like this block. See docs/notifications.md.
# Notifications delivered per WF-10 pass.
NOTIFY_BATCH_SIZE=10
# Delivery attempts before a notification is left at 'failed' for good. It stays
# in the table either way; WF-101 reports anything that ran out.
NOTIFY_MAX_ATTEMPTS=5
# Minutes before the first retry, multiplied by the attempt count. Without a
# backoff a five minute schedule burns all five attempts in 25 minutes, and an
# outage shorter than lunch drops the day's notifications.
NOTIFY_RETRY_BACKOFF_MINUTES=10
# How long a row may sit at 'sending' before another run may re-claim it.
NOTIFY_STALE_CLAIM_MINUTES=10
# How long the same failure alert stays quiet after being sent (WF-99).
ALERT_COOLOFF_MINUTES=60
# A company that stays HOT is not news twice inside this window (WF-04).
HOT_ALERT_COOLOFF_DAYS=30

# ---------------------------------------------------------------------------
# Agent health thresholds (WF-101)                            OPTIONAL
# ---------------------------------------------------------------------------
# Share of an agent's 24h runs that may fail before it is reported.
HEALTH_ERROR_RATE_THRESHOLD=0.25
# Below this many runs a failure rate means nothing, so none is computed.
HEALTH_ERROR_RATE_MIN_RUNS=3
# An agent_runs row still 'running' after this is treated as a dead run.
HEALTH_STUCK_RUN_MINUTES=15
# A company left at 'researching' this long has lost its run.
HEALTH_ORPHAN_RESEARCH_MINUTES=120
# Work may wait this long before an agent that never ran is reported.
HEALTH_STALLED_QUEUE_HOURS=6
# How long a health alert stays quiet after being sent.
HEALTH_ALERT_COOLOFF_MINUTES=360

# ---------------------------------------------------------------------------
# Lead data provider                                          OPTIONAL (Phase 4)
# ---------------------------------------------------------------------------
APOLLO_API_KEY=
APOLLO_API_BASE=https://api.apollo.io/v1
# Hard ceiling on provider credits consumed per day.
APOLLO_DAILY_LIMIT=100

# ---------------------------------------------------------------------------
# Email / outreach delivery                                   OPTIONAL (Phase 7)
# ---------------------------------------------------------------------------
# smtp, and only smtp.
#
# This used to read "smtp | resend | postmark | sendgrid". All three of those
# explicitly prohibit cold outreach in their acceptable-use policies - Resend
# bars unsolicited mail and scraped contacts outright, SendGrid treats
# prospecting mail as a ToS violation and suspends without warning, Postmark
# closes such accounts within days and a dedicated IP does not exempt you.
# They are transactional ESPs on shared IP pools; this system is not a
# transactional sender. Reaching for one of them as the easy option gets the
# account killed AFTER mail has gone out, which is the worst available moment.
#
# What this system needs is an ordinary mailbox: WF-08 has to read replies
# over IMAP, and a transactional API is one-way.
EMAIL_PROVIDER=smtp
# The envelope. The visible greeting and signature are not here - they are in
# prompts/signature.md, because they are message text and this file is secrets.
EMAIL_FROM=
# Quote this if it contains anything a shell would read as syntax - brackets,
# parentheses, a quote. infra/scripts/migrate.sh sources this file with bash,
# and an unquoted "Name (Company)" is a syntax error that stops migrations from
# running at all, with an error that names a line number and not a cause.
EMAIL_FROM_NAME=
# Replies have to land in a mailbox a human reads, and later WF-08 over IMAP.
EMAIL_REPLY_TO=
# Google Workspace: smtp.gmail.com on 465 with implicit TLS, or 587 with
# STARTTLS (then set SMTP_SECURE=false - the flag means implicit TLS, not
# "use encryption"). SMTP_USER is the full mailbox address, not a short name.
#
# SMTP_PASSWORD is an APP PASSWORD, never the account password. Google
# disabled basic auth for IMAP/POP/SMTP in May 2025; app passwords are the
# surviving exception and they require 2-Step Verification to be on first.
# Generate at myaccount.google.com/apppasswords. It is shown once.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
# IMAP for the reply watcher (WF-08). Google Workspace: imap.gmail.com on 993,
# with the same app password. IMAP must also be enabled for the mailbox in the
# admin console - it is off by default on some plans.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ---------------------------------------------------------------------------
# Outreach safety rails                                       REQUIRED
# ---------------------------------------------------------------------------
# Guarded autosend, the master switch (0030_autosend.sql). Off by default, and
# it should stay off until you have read every draft for a few weeks and trust
# what the blockers catch. Only the operator turns it on. With "true" here (then make deploy) and /autosend on in Telegram,
# WF-05 approves a first message that autosend_blockers() finds nothing wrong
# with; everything else, and every follow-up, still waits for /approve. /stop
# turns it off at once. Anything but the exact string "true" keeps it off,
# whatever Telegram says. WF-06's limits and OUTREACH_PAUSED still apply.
# docs/outreach-generation.md, "Guarded autosend".
OUTREACH_AUTOSEND_ENABLED=false
# A domain with no sending history that opens at 20/day looks exactly like a
# domain someone just bought to spam from, because that is what one is. Warm
# up: 5/day for the first week, then roughly double weekly while the DMARC
# aggregate reports stay clean. 20 is the ceiling, not the starting point.
OUTREACH_DAILY_LIMIT=5
OUTREACH_PER_DOMAIN_LIMIT=1
OUTREACH_MIN_SCORE=60
# Follow-ups (WF-05): at most MAX after the first message, each DELAY_DAYS after
# the previous one was sent, only while nobody has replied, each approved over
# Telegram like the first. 0 turns them off.
OUTREACH_FOLLOWUP_MAX=2
OUTREACH_FOLLOWUP_DELAY_DAYS=4
# How many messages WF-06 sends per run. The daily limit still applies, so this
# only controls how evenly the day's allowance is spread.
OUTREACH_DISPATCH_BATCH_SIZE=5
# The window WF-06 will send in, in GENERIC_TIMEZONE rather than the server's.
# Hours are 24h and the end is exclusive: 9 and 17 means 09:00-16:59 local.
# Days are ISO: 1 is Monday, 7 is Sunday.
OUTREACH_WORKING_HOUR_START=9
OUTREACH_WORKING_HOUR_END=17
OUTREACH_WORKING_DAYS=1,2,3,4,5
# Global kill switch honoured by every dispatch workflow. WF-06 reads it as
# the first of its guards: anything other than the exact string "false" leaves
# it paused, so a typo stops sending rather than starting it.
OUTREACH_PAUSED=true
# Language of the first message, by the company's country (ISO code). A
# language needs a block in prompts/outreach.md and a greeting and signature in
# prompts/signature.md; only "sr" (Serbian) ships. Every other country is
# English. Empty, or "none", means English everywhere. Example:
#   OUTREACH_LANGUAGES=RS:sr,HR:sr,BA:sr,ME:sr
OUTREACH_LANGUAGES=
# Those regional leads are written by OUTREACH_NIGHT_MODEL, and only in this
# window (GENERIC_TIMEZONE, 24h, end exclusive: 1 and 5 means 01:00-04:59).
# The 9B model's Serbian had errors in every draft; the 27B model's is usable,
# but the two do not fit in 24 GB together, so the night batch gets the GPU to
# itself: while it runs, research, enrichment and scoring claim nothing
# (0023_night_drafting.sql, docs/outreach-generation.md). Everyone else is
# written in English by OLLAMA_OUTREACH_MODEL outside the window.
OUTREACH_NIGHT_MODEL=qwen3.6:27b
OUTREACH_NIGHT_HOUR_START=1
OUTREACH_NIGHT_HOUR_END=5
# Drafts per night run. The model loads once for the whole batch; a draft takes
# about a minute once it is loaded.
OUTREACH_NIGHT_BATCH_SIZE=20

# ---------------------------------------------------------------------------
# Backups                                                     OPTIONAL
# ---------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Passphrase for gpg symmetric encryption of dumps. Empty = unencrypted (not
# recommended for anything leaving the machine).
BACKUP_PASSPHRASE=

# ---------------------------------------------------------------------------
# Dashboard                                                   REQUIRED
# ---------------------------------------------------------------------------
# The web dashboard: overview, approval queue, companies, replies, segments,
# system health. One operator login; nothing else reaches it.
#
# DASHBOARD_PASSWORD is the login password. DASHBOARD_SESSION_SECRET signs the
# session cookie (rotating it logs everyone out). DASHBOARD_DB_PASSWORD is the
# password of the aisales_dashboard database role, which can read and call
# the approval functions but cannot write to a table directly; `make
# dashboard-role` applies it. `make init` generates all three when empty.
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_DB_PASSWORD=
# Loopback only, like everything else. For other devices use
# `tailscale serve --bg 3000`, never a wider bind.
DASHBOARD_BIND_ADDR=127.0.0.1
DASHBOARD_PORT=3000
# Visual style: "default" (dense, Linear-like) or "apple" (macOS system colours,
# SF Pro on Apple devices, larger radii, translucent sidebar).
DASHBOARD_STYLE=default

# ---------------------------------------------------------------------------
# Image versions                                              REQUIRED
# ---------------------------------------------------------------------------
# Pinned on purpose. Verify each tag exists before the first deploy, then bump
# deliberately - never move any of these to :latest.
POSTGRES_IMAGE=postgres:16.6-alpine
N8N_IMAGE=n8nio/n8n:1.123.81
CADDY_IMAGE=caddy:2.8-alpine

# Contacts from the company's own public repositories (WF-03). A commit records
# its author's name and work address, which is the observed address WF-03's
# pattern inference needs and which company websites no longer publish.
# GITHUB_TOKEN is optional: without it GitHub allows 60 API calls an hour, which
# fits ENRICH_BATCH_SIZE=3 on an hourly schedule and not much more. A read-only
# token with no scopes raises it to 5000.
#
# Off by default. A commit address is published for attribution, not to be
# written to, which is weaker footing than docs/security.md asks for, and
# GitHub's Acceptable Use Policies forbid using data from the service to send
# unsolicited email. Read docs/contact-enrichment.md before turning it on.
ENRICH_GITHUB_ENABLED=false
ENRICH_GITHUB_MAX_ORGS=3
ENRICH_GITHUB_MAX_REPOS=3
ENRICH_GITHUB_COMMITS_PER_REPO=40
ENRICH_GITHUB_MAX_PEOPLE=12
ENRICH_GITHUB_INTERVAL_MS=400
GITHUB_TOKEN=
